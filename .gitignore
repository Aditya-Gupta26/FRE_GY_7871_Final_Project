# Data is not committed. Everything under data/ is reproducible from scripts/, except the
# Claude labels and codes (data/labels, data/coded), which cannot be re-pulled exactly.
data/**
!data/
!data/*/
!data/**/.gitkeep
!data/labels/*.csv
!data/labels/*.md
!data/labels/*_key.csv
!data/coded/*.csv
# text-free processed data (panels, Michigan series, media measures, Tier C predictions by doc_id), so the
# analysis, figures, dashboard and notebook run from a clone without the (non-redistributable) text
!data/processed/*.parquet
!data/processed/*.csv
# Claude labels (no text): annotators A and B, the adjudicator, the dev labeller
!data/labels/*labels*.jsonl
!data/labels/gold_adjudicated*.jsonl
# sheets and batch files hold raw headline / post text; regenerated by script with fixed seeds
data/labels/*sheet*.csv
data/labels/*sheet*.jsonl
data/coded/batches/

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store
.claude/
outputs/*
!outputs/.gitkeep
!outputs/figures/
!outputs/figures/*.png
!outputs/tables/
!outputs/tables/*.csv
!outputs/tables/*.json
!outputs/results*.json

# working files, not graded deliverables
PROGRESS.md
PLAN.md
logs/

# course brief, the course data file and the private pre-prompt: not ours to redistribute
Final_Project_Applications_in_Finance_Oct_2026.pdf
Final_Project_Pre_Prompt.md
Perceptual_Bias_Data.xlsx
Materials/
